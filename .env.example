# Contoh konfigurasi environment untuk Perisai WAF (Docker).
# Salin menjadi .env lalu isi:  cp .env.example .env
#
# Semua variabel opsional kecuali INITIAL_PASSWORD (bila belum ada password).

# Port proxy WAF (lalu lintas website yang dilindungi)
PORT=8080

# Port dashboard admin
DASHBOARD_PORT=8899

# Host bind (0.0.0.0 = semua interface, wajib untuk Docker)
HOSTNAME=0.0.0.0

# Direktori data SQLite di dalam container
DATA_DIR=/app/data

# Login dashboard awal — hanya dipakai bila belum ada password tersimpan.
# Setelah pertama kali diset, password tersimpan permanen (mengubah .env tidak
# akan menimpa password yang sudah ada).
INITIAL_USER=admin
INITIAL_PASSWORD=ganti-dengan-password-kuat

# Token API statis untuk skrip/otomasi (opsional).
# Buat dengan:  openssl rand -hex 32
DASHBOARD_TOKEN=

# Kunci API opsional (bila dipakai)
PERISAI_LLM_KEY=
PERISAI_SYSTEMONE_KEY=
PERISAI_RECAPTCHA_SECRET=
PERISAI_CF_TOKEN=
